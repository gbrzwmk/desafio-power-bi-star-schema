model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["PastaDados", "Dim_Departamento", "Dim_Professor", "Dim_Curso", "Dim_Disciplina", "Dim_Data", "Fato_Professor"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table Dim_Departamento
ref table Dim_Professor
ref table Dim_Curso
ref table Dim_Disciplina
ref table Dim_Data
ref table Fato_Professor

ref expression PastaDados
