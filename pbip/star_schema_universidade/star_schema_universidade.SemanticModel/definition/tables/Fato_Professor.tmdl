table Fato_Professor
	lineageTag: 213d3521-5691-49e6-9d82-172d63493008

	measure 'Horas Ministradas' = SUM(Fato_Professor[horas_ministradas])
		formatString: #,0
		lineageTag: ab94d24f-a20d-4e9d-8eb1-7162c75c368d

	measure 'Qtd Turmas' = SUM(Fato_Professor[qtd_turmas])
		formatString: #,0
		lineageTag: 17a1876f-78a0-4501-b74b-724498782b8e

	measure 'Ofertas de Disciplina' = COUNTROWS(Fato_Professor)
		formatString: #,0
		lineageTag: cb34467d-5f7d-4570-bfaa-60073a3201b2

	measure 'Professores Ativos' = DISTINCTCOUNT(Fato_Professor[id_professor])
		formatString: #,0
		lineageTag: bba0696a-0173-4e4b-942e-db8f4d3536ce

	measure 'Cursos Atendidos' = DISTINCTCOUNT(Fato_Professor[id_curso])
		formatString: #,0
		lineageTag: f67f403a-97b9-44b1-b4ae-e2829c22a40d

	measure 'Disciplinas Distintas' = DISTINCTCOUNT(Fato_Professor[id_disciplina])
		formatString: #,0
		lineageTag: c2b6d71e-ec12-47be-971e-38661b3f5c85

	measure 'Média de Horas por Professor' = DIVIDE([Horas Ministradas], [Professores Ativos])
		formatString: #,0.0
		lineageTag: 0ccf307a-af7b-493a-930c-f75c1429ff65

	measure 'Ofertas por Data do Curso' = CALCULATE([Ofertas de Disciplina], USERELATIONSHIP(Fato_Professor[id_data_oferta_curso], Dim_Data[id_data]))
		formatString: #,0
		lineageTag: 9a3d4be1-4697-4051-be10-a8a24f80dbfc

